#!/usr/bin/env python3
"""Stand-in for gamescope: records its args and the panel state while 'running', then exits."""
import json, os, sys
out = os.environ["FAKE_GAMESCOPE_OUT"]
panels = json.load(open(os.environ["FAKE_PANELS"])) if os.environ.get("FAKE_PANELS") else None
json.dump({"args": sys.argv[1:], "panels_during_game": panels}, open(out, "w"))
sys.exit(int(os.environ.get("FAKE_GAMESCOPE_RC", "0")))
